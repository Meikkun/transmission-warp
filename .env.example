# Required host paths
DOWNLOADS_DIR=/media/HDD2
TRANSMISSION_CONFIG_DIR=/home/your-user/.config/transmission

# LAN access and published Transmission Web UI port
LOCAL_NETWORK=192.168.1.0/24
HOST_PORT=9092

# Optional guarded Sonarr/Radarr cleanup
ARR_CLEANUP_ENABLED=true
MEDIA_DIR=/media
SONARR_CONFIG_DIR=/home/your-user/.config/Sonarr
RADARR_CONFIG_DIR=/home/your-user/.config/Radarr
ARR_CLEANUP_INTERVAL_SECONDS=120
ARR_CLEANUP_MAX_SEEDING_DAYS=14

# Optional identity and naming overrides
# PUID=1000
# PGID=1000
# IMAGE_NAME=local/transmission-warp:latest
# CONTAINER_NAME=transmission
# WARP_DATA_DIR=/path/to/private/warp-state
